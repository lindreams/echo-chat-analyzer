+"""Explicit citations inside one retained group conversation.
+
+References are positions in the supplied retained Rich messages. They are not
+source IDs and grant no access to filtered or out-of-window messages. Unknown
+sources stay unavailable, rather than being reported as having zero citations.
+"""
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+from ..rich_message import ReplyRelation, RichMessage
+from .timestamps import to_epoch_seconds
+
+
+@dataclass(frozen=True, slots=True)
+class GroupReplyPair:
+    sender_id: str = field(repr=False)
+    target_sender_id: str = field(repr=False)
+    count: int
+    message_refs: tuple[tuple[int, int], ...] = field(repr=False)
+
+
+@dataclass(frozen=True, slots=True)
+class GroupReplies:
+    available: bool
+    observed_count: int = 0
+    linked_count: int = 0
+    self_count: int = 0
+    unresolved_count: int = 0
+    pairs: tuple[GroupReplyPair, ...] = field(default=(), repr=False)
+
+
+def analyze_group_replies(messages: tuple[RichMessage, ...]) -> GroupReplies:
+    """Resolve only unique IDs, explicit identities and strictly earlier targets."""
+    messages = tuple(messages)
+    scopes = {(m.source, m.conversation_type, m.conversation_id) for m in messages}
+    if (len(scopes) != 1 or not messages or messages[0].conversation_type != 'group'
+            or not messages[0].conversation_id):
+        return GroupReplies(False)
+    source = messages[0].source
+    if not ((source == 'qq' and all(m.source_type == 'qq-db-json' for m in messages))
+            or (source == 'wechat' and all(type(m.source_type) is int for m in messages))):
+        return GroupReplies(False)
+
+    ids = defaultdict(list)
+    for ref, message in enumerate(messages):
+        if message.message_id:
+            ids[message.message_id].append(ref)
+    pairs = defaultdict(list)
+    observed = linked = own = unresolved = 0
+    for ref, message in enumerate(messages):
+        relations = [relation for relation in message.relations if isinstance(relation, ReplyRelation)]
+        if message.is_system or (message.message_type != 'reply' and not relations):
+            continue
+        observed += 1
+        sender = message.sender.identity_id
+        candidates = ids.get(relations[0].target_message_id, ()) if len(relations) == 1 else ()
+        moment = to_epoch_seconds(message.timestamp)
+        if (not sender or not sender.strip() or not message.message_id
+                or len(ids[message.message_id]) != 1 or len(candidates) != 1 or moment is None):
+            unresolved += 1
+            continue
+        target_ref = candidates[0]
+        target = messages[target_ref]
+        target_sender = target.sender.identity_id
+        target_moment = to_epoch_seconds(target.timestamp)
+        if (not target_sender or not target_sender.strip() or target.is_system
+                or target_ref >= ref or target_moment is None or target_moment >= moment
+                or (relations[0].target_sender_id is not None and relations[0].target_sender_id != target_sender)
+                or (source == 'wechat' and relations[0].target_sender_id is None)):
+            unresolved += 1
+            continue
+        if sender == target_sender:
+            own += 1
+            continue
+        linked += 1
+        pairs[sender, target_sender].append((ref, target_ref))
+
+    # Equal counts retain first-observed order; account IDs never determine a
+    # visible ranking. Each quote contributes one edge, including quote chains.
+    ordered = sorted(pairs.items(), key=lambda item: -len(item[1]))
+    return GroupReplies(True, observed, linked, own, unresolved, tuple(
+        GroupReplyPair(sender, target, len(refs), tuple(refs))
+        for (sender, target), refs in ordered
+    ))
