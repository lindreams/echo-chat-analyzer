+"""Fictional WeChat group citations, reconstructed from structural evidence."""
+from xml.sax.saxutils import escape
+
+import pytest
+import zstandard
+
+from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+from qq_chat_analyzer.legacy_projection import project_legacy_messages
+from qq_chat_analyzer.wechat_db_adapter import messages_from_payload, parse_rich_messages
+
+
+ROOM = 'wxid_fictional_reply_room@chatroom'
+QUOTE = (57 << 32) | 49
+
+
+def quote(text='明天一起去看展。', target=91001, author='wxid_fictional_alpha', *, room=ROOM):
+    return ('<msg><appmsg><title>'+escape(text)+'</title><type>57</type><refermsg>'
+            f'<type>1</type><svrid>{target}</svrid><fromusr>{room}</fromusr><chatusr>{author}</chatusr>'
+            '<displayname>虚构成员</displayname><content>不要计入词频的引用快照</content>'
+            '</refermsg></appmsg></msg>')
+
+
+def row(identifier, sender, text, *, kind=1, when=1760000000, local=71):
+    return {'server_id':identifier,'local_id':local,'local_type':kind,'create_time':when,
+            'message_content':text,'user_name':sender}
+
+
+def parse(rows, *, room=ROOM):
+    return parse_rich_messages(messages_from_payload({'source':'wechat-db',
+        'conversation':{'username':room,'session_type':'group' if room.endswith('@chatroom') else 'private'},
+        'messages':rows}))
+
+
+@pytest.mark.parametrize('compressed',[False,True])
+def test_group_quote_keeps_authored_title_and_structured_target_separate(compressed):
+    raw = row(91002,'wxid_fictional_beta','wxid_fictional_beta:\n'+quote(),kind=QUOTE,when=1760000010)
+    if compressed:
+        raw['message_content']=zstandard.ZstdCompressor().compress(raw['message_content'].encode()).hex()
+        raw['WCDB_CT_message_content']=4
+    messages = parse([row(91001,'wxid_fictional_alpha','去看新的画展。'),raw])
+    assert len(messages)==2
+    answer = messages[1]
+    assert project_legacy_messages(messages)[1].text=='明天一起去看展。'
+    assert answer.message_type=='reply'
+    assert answer.relations[0].target_message_id=='91001'
+    assert answer.relations[0].target_sender_id=='wxid_fictional_alpha'
+    result = analyze_group_replies(messages)
+    assert result.available and result.linked_count==1
+
+
+def test_chains_repeated_targets_and_sticker_quotes_use_the_same_group_analysis():
+    alpha,beta='wxid_fictional_alpha','wxid_fictional_beta'
+    rows=[row(91001,alpha,'一起去看画展吧。'),
+          row(91002,beta,quote(target=91001,author=alpha),kind=QUOTE,when=1760000010),
+          row(91003,alpha,quote('我来订票。',target=91002,author=beta),kind=QUOTE,when=1760000020),
+          row(91004,beta,quote('再叫一位朋友。',target=91001,author=alpha),kind=QUOTE,when=1760000030),
+          row(91005,alpha,'<msg><emoji type="2" md5="'+'a'*32+'"/></msg>',kind=47,when=1760000040),
+          row(91006,beta,quote('好可爱的表情。',target=91005,author=alpha),kind=QUOTE,when=1760000050)]
+    result=analyze_group_replies(parse(rows))
+    assert result.linked_count==4 and result.observed_count==4
+    assert [(pair.count,pair.sender_id) for pair in result.pairs]==[(3,beta),(1,alpha)]
+
+
+@pytest.mark.parametrize('damage',['foreign_room','wrong_author','invalid_server_id','local_id_collision',
+                                   'duplicate_field','duplicate_target','missing_reply_server_id'])
+def test_target_namespace_scope_and_author_are_required(damage):
+    alpha,beta='wxid_fictional_alpha','wxid_fictional_beta'
+    original=row(91001,alpha,'一起去看画展吧。',local=91001)
+    xml=quote(target=91001,author=alpha)
+    extras=[]
+    if damage=='foreign_room': xml=quote(room='another_fictional_room@chatroom')
+    elif damage=='wrong_author': xml=quote(author='wxid_fictional_other')
+    elif damage=='invalid_server_id': xml=quote(target=0)
+    elif damage=='local_id_collision': original['server_id']=0
+    elif damage=='duplicate_field': xml=xml.replace('</svrid>','</svrid><svrid>91001</svrid>')
+    elif damage=='duplicate_target': extras=[row(91001,'wxid_fictional_other','同 ID 的不同虚构消息。')]
+    answer=row(0 if damage=='missing_reply_server_id' else 91002,beta,xml,kind=QUOTE,when=1760000010)
+    messages=parse([original,*extras,answer])
+    result=analyze_group_replies(messages)
+    assert result.linked_count==0 and result.unresolved_count==1
+    assert project_legacy_messages(messages)[-1].text=='明天一起去看展。'
+
+
+@pytest.mark.parametrize('xml',[quote().replace('<type>57</type>','<type>62</type>'),
+                              quote().replace('<title>','<title><b>').replace('</title>','</b></title>'),
+                              '<!DOCTYPE msg [<!ENTITY x "secret">]>'+quote()])
+def test_unverified_or_ambiguous_xml_is_not_interpreted_as_a_reply(xml):
+    assert parse([row(91002,'wxid_fictional_beta',xml,kind=QUOTE)])==[]
+
+
+def test_private_quotes_are_not_enabled_by_the_group_feature():
+    assert parse([row(91002,'wxid_fictional_beta',quote(),kind=QUOTE)],room='wxid_fictional_peer')==[]
