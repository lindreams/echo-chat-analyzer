@@ -0,0 +1,217 @@
+"""Explicit group citations use retained facts, never guessed adjacency."""
+from dataclasses import replace
+
+import pytest
+
+from qq_chat_analyzer.rich_message import ReplyRelation, RichMessage, SenderIdentity, TextContent
+
+
+def message(identifier, sender, timestamp, *, target=None, kind='group', source='qq'):
+    return RichMessage(
+        message_id=identifier, source=source, source_type='qq-db-json',
+        conversation_id='fictional-room', conversation_type=kind,
+        sender=SenderIdentity(sender, '同名成员'), timestamp=timestamp,
+        message_type='reply' if target is not None else 'text',
+        contents=(TextContent('虚构原话'),),
+        relations=(ReplyRelation(target),) if target is not None else (),
+    )
+
+
+def test_directed_citations_and_unresolved_quotes_have_separate_counts():
+    from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+
+    messages = (
+        message('original', 'alice', 100),
+        message('answer', 'bob', 110, target='original'),
+        message('another', 'bob', 120, target='original'),
+        message('self', 'alice', 130, target='original'),
+        message('outside', 'carol', 140, target='filtered-out'),
+        message('ordinary', 'carol', 150),
+    )
+    report = analyze_group_replies(messages)
+    assert report.available
+    assert (report.observed_count, report.linked_count, report.self_count, report.unresolved_count) == (4, 2, 1, 1)
+    assert len(report.pairs) == 1
+    pair = report.pairs[0]
+    assert (pair.sender_id, pair.target_sender_id, pair.count) == ('bob', 'alice', 2)
+    assert pair.message_refs == ((1, 0), (2, 0))
+
+
+@pytest.mark.parametrize('damage', ['duplicate_target', 'duplicate_reply', 'missing_sender',
+                                   'same_second', 'reversed_time', 'unknown_time', 'multiple_targets'])
+def test_ambiguous_identity_target_or_order_does_not_create_a_pair(damage):
+    from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+
+    original = message('original', 'alice', 100)
+    answer = message('answer', 'bob', 110, target='original')
+    extra = []
+    if damage == 'duplicate_target':
+        extra = [replace(original, sender=SenderIdentity('carol', '同名成员'))]
+    elif damage == 'duplicate_reply':
+        extra = [replace(answer, message_type='text', relations=())]
+    elif damage == 'missing_sender':
+        original = replace(original, sender=SenderIdentity(None, '同名成员'))
+    elif damage == 'same_second':
+        answer = replace(answer, timestamp=100)
+    elif damage == 'reversed_time':
+        answer = replace(answer, timestamp=90)
+    elif damage == 'unknown_time':
+        original = replace(original, timestamp='unknown')
+    else:
+        answer = replace(answer, relations=(ReplyRelation('original'), ReplyRelation('other')))
+    report = analyze_group_replies((original, *extra, answer))
+    assert report.available
+    assert report.linked_count == 0 and report.unresolved_count == 1
+    assert report.pairs == ()
+
+
+@pytest.mark.parametrize('kind,source', [('private', 'qq'), ('unknown', 'qq'), ('group', 'wechat')])
+def test_unverified_sources_and_private_chats_are_unavailable(kind, source):
+    from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+
+    report = analyze_group_replies((message('original', 'alice', 100, kind=kind, source=source),))
+    assert not report.available
+    assert report.pairs == ()
+
+
+def test_mixed_conversations_fail_closed_instead_of_joining_equal_message_ids():
+    from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+
+    original = message('original', 'alice', 100)
+    foreign = replace(message('answer', 'bob', 110, target='original'), conversation_id='other-room')
+    assert not analyze_group_replies((original, foreign)).available
+
+
+def test_view_uses_retained_originals_and_display_labels_without_source_identifiers():
+    import json
+    from dataclasses import asdict
+    from qq_chat_analyzer.analysis.group_replies import analyze_group_replies
+    from qq_chat_analyzer.legacy_projection import project_legacy_messages
+    from qq_chat_analyzer.presentation.group_replies import build_group_reply_view
+    from qq_chat_analyzer.presentation.models import EchoMemberCard, EchoReportView
+
+    rich = (message('original', 'alice', 100), message('answer', 'bob', 110, target='original'))
+    members = tuple(EchoMemberCard(
+        speaker_key=key, display_name='同名成员', is_viewer=False, message_count=1,
+        message_share_percent=50, average_length=4, max_length=4, active_period='晚上',
+    ) for key in ('alice', 'bob'))
+    view = EchoReportView(title='虚构群', conversation_kind='group', members=members)
+    result = build_group_reply_view(view, analyze_group_replies(rich), project_legacy_messages(rich))
+    pair = result.pairs[0]
+    assert pair.sender_label != pair.target_label
+    assert pair.message_refs == ((1, 0),)
+    assert [m.ref for m in result.messages] == [0, 1]
+    assert all(m.text == '虚构原话' for m in result.messages)
+    payload = json.dumps(asdict(result))
+    assert 'alice' not in payload and 'bob' not in payload and 'message_id' not in payload
+    assert build_group_reply_view(replace(view, conversation_kind='private'), analyze_group_replies(rich),
+                                 project_legacy_messages(rich)) is None
+    from qq_chat_analyzer.presentation.echo_serializer import echo_report_to_dict
+    assert echo_report_to_dict(replace(view, conversation_kind='private', group_replies=result))['group_replies'] is None
+
+
+def test_report_construction_joins_only_surviving_rich_projection_pairs():
+    from qq_chat_analyzer.application.analysis_service import _build_reports
+    from qq_chat_analyzer.legacy_projection import project_legacy_messages
+
+    rich = (message('original', 'alice', 100), message('answer', 'bob', 110, target='original'))
+    legacy = project_legacy_messages(rich)
+    mapping = {id(plain): fact for plain, fact in zip(legacy, rich, strict=True)}
+    complete = _build_reports(legacy, [], conversation_type='group', rich_by_instance=mapping)
+    assert complete.group_replies.linked_count == 1
+    filtered = _build_reports(legacy[1:], [], conversation_type='group', rich_by_instance=mapping)
+    assert filtered.group_replies.linked_count == 0
+    assert filtered.group_replies.unresolved_count == 1
