+"""Offline group citation chapter; originals use the existing read-only dialog."""
+
+ECHO_REPLIES_CSS = r"""
+.replies-chapter { min-height: 0; }
+.reply-overview { display: flex; flex-wrap: wrap; gap: 24px 48px; margin: 28px 0; padding: 20px 0; border-block: 1px solid var(--rule); }
+.reply-stat { display: grid; gap: 8px; }
+.reply-stat span, .reply-hint { color: var(--muted); font: 12px/1.8 var(--sans); }
+.reply-stat strong { font: 30px/1.3 var(--serif); font-weight: 400; }
+.reply-pair { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 16px 0; border: 0; border-bottom: 1px solid var(--rule); background: transparent; color: var(--ink); text-align: left; font: 17px/1.8 var(--serif); cursor: pointer; }
+.reply-pair span { overflow-wrap: anywhere; }
+.reply-pair:hover { color: var(--accent); }
+.reply-pair:focus-visible, .reply-more:focus-visible { outline: 1px solid var(--viewer); outline-offset: 3px; }
+.reply-more { border: 0; background: none; color: var(--accent); padding: 14px 0; cursor: pointer; font: 12px/1.8 var(--sans); }
+.reply-citation-label { margin: 0; color: var(--muted); font: 11px/1.8 var(--sans); }
+@media print { .reply-more { display: none; } .reply-pair { break-inside: avoid; } }
+"""
+
+ECHO_REPLIES_APP_JS = r"""
+(function () {
+  "use strict";
+  var data = window.ECHO_DATA, report = data && data.group_replies;
+  var chapter = document.getElementById("replies"), toc = document.getElementById("replies-toc");
+  if (!chapter || !toc) return;
+  var available = !!(data.conversation && data.conversation.kind === "group" && report);
+  chapter.hidden = toc.hidden = !available;
+  var futurePage = document.getElementById("future-page-number");
+  if (futurePage) futurePage.textContent = available ? "09" : "08";
+  if (!available) return;
+  function element(tag, cls, text) {
+    var node = document.createElement(tag); node.className = cls; node.textContent = text; return node;
+  }
+  var pairs = report.pairs || [], overview = document.getElementById("reply-overview");
+  [["可定位的成员间引用", report.linked_count], ["有向引用组合", pairs.length]].forEach(function (item) {
+    var stat = element("div", "reply-stat", "");
+    stat.appendChild(element("span", "", item[0])); stat.appendChild(element("strong", "", item[1])); overview.appendChild(stat);
+  });
+  var note = "仅统计当前保留范围内的明确引用，不代表全部接话或关系亲疏。";
+  if (report.unresolved_count) note += " 另有 " + report.unresolved_count + " 条引用因目标缺失、身份或顺序不明，未计入组合。";
+  if (report.self_count) note += " 引用自己 " + report.self_count + " 次，单独排除。";
+  if (!report.observed_count) note += " 当前范围未识别到明确引用。";
+  document.getElementById("reply-note").textContent = note;
+  var list = document.getElementById("reply-pairs"), more = document.getElementById("reply-more"), rendered = 0;
+  function appendUntil(limit) {
+    for (; rendered < Math.min(limit, pairs.length); rendered++) {
+      (function (pair) {
+        var button = element("button", "reply-pair", ""); button.type = "button";
+        button.appendChild(element("span", "", pair.sender_label + " → " + pair.target_label));
+        button.appendChild(element("span", "", pair.count + " 次"));
+        button.addEventListener("click", function () {
+          document.getElementById("language-originals").dispatchEvent(new CustomEvent("echo:replies", {detail: {pair: pair, trigger: button}}));
+        });
+        list.appendChild(button);
+      })(pairs[rendered]);
+    }
+    more.hidden = rendered >= pairs.length;
+  }
+  more.addEventListener("click", function () { appendUntil(rendered + 10); });
+  window.addEventListener("beforeprint", function () { appendUntil(pairs.length); });
+  appendUntil(10);
+})();
+"""
diff --git a/tests/test_group_replies.py b/tests/test_group_replies.py
