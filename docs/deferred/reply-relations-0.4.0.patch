+"""Explicit group citation display projection, without source IDs or snapshots."""
+from ..analysis.group_replies import GroupReplies
+from .language_sources import build_original_message, original_speaker_labels
+from .models import EchoGroupReplies, EchoGroupReplyPair
+
+
+def build_group_reply_view(view, report: GroupReplies | None, messages) -> EchoGroupReplies | None:
+    if view.conversation_kind != 'group' or report is None or not report.available:
+        return None
+    labels = original_speaker_labels(view)
+    needed = {ref for pair in report.pairs for refs in pair.message_refs for ref in refs}
+    # A stale/misaligned result must never show a different original at a ref.
+    if any(not 0 <= ref < len(messages) for ref in needed):
+        raise ValueError('group_reply_alignment')
+    pairs = tuple(EchoGroupReplyPair(
+        labels.get(pair.sender_id, '未知成员'), labels.get(pair.target_sender_id, '未知成员'),
+        pair.count, pair.message_refs,
+    ) for pair in report.pairs)
+    return EchoGroupReplies(
+        report.observed_count, report.linked_count, report.self_count, report.unresolved_count,
+        pairs, tuple(build_original_message(messages[ref], ref, labels) for ref in sorted(needed)),
+    )
